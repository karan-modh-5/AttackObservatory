# Attack Observatory — environment template.
# Copy to `.env` and fill in the CHANGE_ME_* values before `docker compose up`:
#   cp .env.example .env
# Secrets (generate each with):  openssl rand -hex 32

# ---------------------------------------------------------------- API (contract §6)
# JWT signing secret. REQUIRED. Generate: openssl rand -hex 32
OBS_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Dashboard admin username (login at http://<host>/).
OBS_ADMIN_USER=admin

# Dashboard admin password. REQUIRED. Generate: openssl rand -hex 32
OBS_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# Shared secret for POST /api/v1/ingest/{source} (X-API-Key header).
# Consumed by api AND fluent-bit. REQUIRED. Generate: openssl rand -hex 32
OBS_INGEST_API_KEY=CHANGE_ME_openssl_rand_hex_32

# Access-token lifetime in minutes.
OBS_TOKEN_EXPIRE_MINUTES=1440

# DuckDB file path inside the api container (duckdb-data volume is mounted at /data).
OBS_DB_PATH=/data/observatory.duckdb

# DuckDB memory_limit pragma. Keep low on the 512MB box.
OBS_DB_MEMORY_LIMIT=128MB

# Events older than this are deleted hourly by the retention job.
OBS_RETENTION_DAYS=90

# Ingest queue capacity (events buffered in RAM before batching into DuckDB).
OBS_QUEUE_MAXSIZE=20000

# MaxMind GeoLite2 license key (free signup: https://www.maxmind.com/en/geolite2/signup).
# OPTIONAL: empty (default) uses the keyless DB-IP free lite databases instead
# (country/city/ASN, auto-downloaded and refreshed weekly, attribution: DB-IP.com).
# A MaxMind key switches to the higher-accuracy GeoLite2 source.
OBS_MAXMIND_LICENSE_KEY=

# Directory (inside api container) where GeoLite2 mmdb files are downloaded.
OBS_GEOIP_DIR=/data/geoip
# Set false to disable GeoIP downloads/enrichment entirely (tests, offline runs).
OBS_GEOIP_ENABLED=true

# API log level (DEBUG|INFO|WARNING|ERROR).
OBS_LOG_LEVEL=INFO

# CORS origins allowed by the API (comma-separated). Same-origin deployments can leave this.
OBS_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- Honeypots
# Snare serves the bundled fake login portal by default (SNARE_PAGE_NAME=portal,
# page files in snare/portal/). To serve a cloned site instead, set
# SNARE_CLONE_SITE + SNARE_PAGE_NAME (page name must equal the root host,
# e.g. https://example.com/foo -> example.com); the clone happens on first start.
SNARE_CLONE_SITE=https://example.com
SNARE_PAGE_NAME=portal

# Hostname cowrie shows in the fake shell prompt. cowrie.cfg ships with the plain
# value `svc-01`; change it there too if you change this (cowrie.cfg does not
# interpolate environment variables).
COWRIE_HOSTNAME=svc-01

# Timezone for all containers (logs, cron-style jobs).
TZ=UTC
